{
  "path": "nvidia/Cosmos3-Super-Text2Image",
  "prompt": "A warehouse robot folds a blue cloth on a clean workbench.",
  "seed": 42,
  "env": {
    "SGLANG_DISABLE_COSMOS3_GUARDRAILS": "1"
