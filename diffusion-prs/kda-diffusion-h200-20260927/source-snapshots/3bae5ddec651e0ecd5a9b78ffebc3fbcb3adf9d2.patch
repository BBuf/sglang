+    # Preserve the pinned reduction order: four consecutive components combined
+    # left-to-right per lane, then a 32-wide tree reduce over lanes.
+    column = tl.arange(0, 128)
+    mask = row[:, None] < ROWS
+    value = tl.load(
+        x_ptr + row[:, None] * 128 + column[None, :],
+        mask,
+        0,
+        eviction_policy="evict_first",
+    ).to(tl.float32)
+    square = tl.reshape(value * value, (RPB, 32, 2, 2))
+    even, odd = tl.split(square)
+    a, c = tl.split(even)
+    b, d = tl.split(odd)
+    variance = tl.sum(((a + b) + c) + d, 1) * (1.0 / 128)
+    inv = tl.rsqrt(variance + EPS)
+    weight = tl.load(weight_ptr + column, eviction_policy="evict_last").to(tl.float32)
+    value = (value * inv[:, None]).to(x_ptr.dtype.element_ty).to(tl.float32)
+    value = (value * weight[None, :]).to(x_ptr.dtype.element_ty).to(tl.float32)
