+    const T* x,
+    const T* cache,
+    T* out,
+    int64_t channels,
+    int64_t t_size,
+    int64_t h_size,
+    int64_t w_size,
+    int64_t cache_t,
+    int64_t pad_d_left,
+    int64_t pad_h_top,
+    int64_t pad_w_left,
