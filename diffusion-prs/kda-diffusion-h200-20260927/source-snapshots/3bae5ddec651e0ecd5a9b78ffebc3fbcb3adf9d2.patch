+// SGL_CUDA_ARCH is injected by load_jit and available in the host pass.
+constexpr bool kUsePDL = SGL_ARCH_HOPPER_OR_GREATER;
+
+struct alignas(4) Pack4 {
+  unsigned char data[4];
+};
