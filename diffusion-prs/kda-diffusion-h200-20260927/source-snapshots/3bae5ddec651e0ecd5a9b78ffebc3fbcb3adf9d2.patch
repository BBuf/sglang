+        return None
+    if factor_t & factor_t - 1 or factor_s & factor_s - 1:
+        return None
+    if repeats <= 0 or repeats & repeats - 1:
+        return None
+    if main.device.type not in ("cuda", "xpu") or src.device.type not in (
+        "cuda",
+        "xpu",
