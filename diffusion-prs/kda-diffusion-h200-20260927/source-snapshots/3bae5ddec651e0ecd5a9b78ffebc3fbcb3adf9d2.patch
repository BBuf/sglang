+  const int64_t warp = threadIdx.x >> 5;
+  const int64_t row_slot = warp / WPR;   // which row in this block
+  const int64_t sub = (warp % WPR) * 32 + lane;  // lane within the row group
+  const int64_t oh = blockIdx.x;
