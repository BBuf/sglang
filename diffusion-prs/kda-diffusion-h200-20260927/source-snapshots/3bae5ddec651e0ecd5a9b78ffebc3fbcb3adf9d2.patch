+                    main,
+                    src,
+                    out,
+                    total,
+                    exp_shape[1],
+                    exp_shape[2],
+                    exp_shape[3],
+                    exp_shape[4],
+                    t_offset,
+                    ssb,
+                    ssc,
+                    sst,
+                    ssh,
+                    ssw,
+                    FT=factor_t,
+                    FS=factor_s,
+                    REPEATS=repeats,
+                    IDX64=IDX64,
+                    EVEN=total % BLOCK == 0,
+                    BLOCK=BLOCK,
+                    num_warps=nw,
+                    maxnreg=64,
+                )
+            else:
+                _dup_up3d_add_contig_cexpr_kernel[grid](
+                    main,
+                    src,
+                    out,
+                    total,
+                    ssb,
+                    ssc,
+                    sst,
+                    ssh,
+                    ssw,
+                    CO=exp_shape[1],
+                    OT=exp_shape[2],
+                    OH=exp_shape[3],
+                    OW=exp_shape[4],
+                    TO=t_offset,
+                    FT=factor_t,
+                    FS=factor_s,
+                    REPEATS=repeats,
+                    IDX64=IDX64,
+                    EVEN=total % BLOCK == 0,
+                    BLOCK=BLOCK,
+                    num_warps=nw,
+                    maxnreg=64,
+                )
+        else:
+            smb, smc, smt, smh, smw = main.stride()
+            sob, soc, sot, soh, sow = out.stride()
+            BLOCK = 512
+            grid = (triton.cdiv(total, BLOCK),)
+            _dup_up3d_add_generic_kernel[grid](
+                main,
+                src,
+                out,
+                total,
+                smb,
+                smc,
+                smt,
+                smh,
+                smw,
+                ssb,
+                ssc,
+                sst,
+                ssh,
+                ssw,
+                sob,
+                soc,
+                sot,
+                soh,
+                sow,
+                FT=factor_t,
+                FS=factor_s,
+                REPEATS=repeats,
+                CO=exp_shape[1],
+                OT=exp_shape[2],
+                OH=exp_shape[3],
+                OW=exp_shape[4],
+                TO=t_offset,
