+  // stride offset, blockIdx.y / gy0 adds a bc offset so arbitrarily large
+  // B*C fits without exceeding the grid.z <= 65535 limit. In the common case
+  // by == 1 so the bc chunk is always 0 and this is identical to the
+  // original mapping.
+  // BIG: grid.y packs (od_chunk, bc_chunk) to support arbitrarily large B*C
+  // without exceeding grid.z<=65535. !BIG (common): original simple mapping.
+  int64_t bc, od_start, od_step;
+  if (BIG) {
+    bc = (blockIdx.z + blockIdx.y / gy * gridDim.z) * ROWS + row_slot;
+    od_start = blockIdx.y % gy;
+    od_step = gy;
+  } else {
+    bc = blockIdx.z * ROWS + row_slot;
+    od_start = blockIdx.y;
+    od_step = gridDim.y;
+  }
