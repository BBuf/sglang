+_FAST_LAUNCH_CACHE: dict = {}
+
+
+_PHASE_A_STREAMS: dict = {}
+
+
+def _phase_a_side_stream():
+    dev = torch.cuda.current_device()
+    s = _PHASE_A_STREAMS.get(dev)
+    if s is None:
+        s = torch.cuda.Stream(device=dev)
+        _PHASE_A_STREAMS[dev] = s
+    return s
+
+
+def _fast_launch(jit_fn, cache_tag, key, grid, pos_args, cexpr, spec_from=None):
+    """Direct-launch a cached compiled Triton kernel.
+
+    cache_tag: identifies which kernel (str). key: the kernel's constexpr /
+    scalar launch signature (must already include every constexpr value and
+    num_warps/num_stages). pos_args: the runtime positional args in def order
+    (tensors + int strides). cexpr: dict of constexpr kwargs + num_warps/
+    num_stages, used only on the first (warm) call for a given binary.
+
+    The full cache key is (cache_tag, device, key, arg-specialization), so
+    calls differing in CUDA device, tensor dtype, pointer alignment, or
+    integer specialization compile/reuse distinct binaries exactly as the
+    normal JIT path would.
+    """
+    if isinstance(grid, int):
+        grid = (grid,)
+    grid0 = grid[0]
+    grid1 = grid[1] if len(grid) > 1 else 1
+    grid2 = grid[2] if len(grid) > 2 else 1
+    device = triton.runtime.driver.active.get_current_device()
+    # Specialization: (dtype, ptr&15) per tensor arg, in order. Integer args
+    # (qkv strides) are already captured in the launch key, and arg positions
+    # are fixed per kernel, so we only need the tensor entries.
+    _TT = torch.Tensor
+    if spec_from is None:
+        spec = tuple((a.dtype, a.data_ptr() & 15) for a in pos_args if type(a) is _TT)
+    else:
+        # Fast path: the caller guarantees every tensor NOT in spec_from is an
+        # internal scratch buffer — freshly allocated by this module
+        # (torch.empty, always >=256-byte aligned) with a dtype already fully
+        # captured by the launch key. Only the listed caller-controlled
+        # tensors can vary in dtype/alignment, so specialize on those alone.
+        spec = tuple(
+            (pos_args[i].dtype, pos_args[i].data_ptr() & 15) for i in spec_from
+        )
+    ck = _FAST_LAUNCH_CACHE.get((cache_tag, device, key, spec))
+    # Hooks are HookChain objects; they are only "active" when they have
+    # registered calls. Bypass the fast path only then (e.g. under a profiler),
+    # so normal launch metadata is generated.
+    # (v15 review notes: the launch_metadata=None passed on the fast path
+    # below exactly matches CompiledKernel.launch_metadata()'s None return
+    # whenever launch_enter_hook is unset — the normal case — so no metadata
+    # is lost; when hooks ARE active we take the JIT path, which builds full
+    # metadata. The cache is keyed by CUDA device via get_current_device(),
+    # so each device's CompiledKernel/function handle is separate. Handles
+    # are context-bound: correct within a process's CUDA context(s), one per
+    # device. A single process driving the same device through multiple
+    # primary contexts is not a supported replay configuration.)
+    # Hook activity must match Triton's launch_metadata contract (v18 repro).
+    # Triton's JIT path builds a LazyDict metadata object whenever
+    # launch_enter_hook is not None — and the default HookChain is NOT None
+    # (it is an empty chain), so the JIT path ALWAYS generates metadata that
+    # any registered exit callback observes. Our fast path passed None, so an
+    # exit-only hook saw None while the JIT path saw a LazyDict — a mismatch.
+    #
+    # Resolution: take the fast path ONLY when both hook chains are empty
+    # (no enter and no exit callbacks) — then no hook runs and metadata is
+    # unobservable, so passing None is indistinguishable from the JIT path.
+    # If EITHER chain has any registered call, fall back to the full JIT
+    # path, which generates the correct metadata. The `_hooks_active` fast
+    # path bypass in the branch below also covers the first (compile) call.
+    _eh = _tl_knobs.runtime.launch_enter_hook
+    _xh = _tl_knobs.runtime.launch_exit_hook
+    _enter_active = bool(getattr(_eh, "calls", None)) or (
+        _eh is not None and not hasattr(_eh, "calls")
+    )
+    _exit_active = bool(getattr(_xh, "calls", None)) or (
+        _xh is not None and not hasattr(_xh, "calls")
+    )
+    _hooks_active = _enter_active or _exit_active
+    if ck is None or _hooks_active:
+        # First call for this binary (compile + cache), or launch hooks active
+        # (e.g. profilers): take the normal JIT path, which compiles for this
+        # exact specialization and builds proper launch metadata.
+        jit_fn[grid](*pos_args, **cexpr)
+        if _hooks_active:
+            return
+        kernel_cache, kernel_key_cache, _target, _backend, binder = (
+            jit_fn.device_caches[device]
+        )
+        bound_args, specialization, options = binder(
+            *pos_args, **cexpr, debug=False, instrumentation_mode=""
+        )
+        ck_key = _tl_compute_cache_key(kernel_key_cache, specialization, options)
+        _FAST_LAUNCH_CACHE[(cache_tag, device, key, spec)] = (
+            kernel_cache[ck_key],
+            list(bound_args.values()),
+        )
+        return
+    ck_kernel, template = ck
+    stream = triton.runtime.driver.active.get_current_stream(device)
+    # Build the launch arg list per call (scalars/constexprs fixed for this
+    # key, positional args refreshed). Copying into a fresh list instead of
+    # mutating the cached template keeps the fast path safe under concurrent
+    # host callers sharing this cache entry (v15 finding); the per-call list
+    # copy costs ~1 us, far less than the ~12 us saved vs the JIT path.
+    launch_args = template.copy()
+    launch_args[: len(pos_args)] = pos_args
+    ck_kernel.run(
+        grid0,
+        grid1,
+        grid2,
+        stream,
+        ck_kernel.function,
+        ck_kernel.packed_metadata,
+        None,
+        _tl_knobs.runtime.launch_enter_hook,
+        _tl_knobs.runtime.launch_exit_hook,
+        *launch_args,
+    )
+
+
+_CHUNKWISE_SHAPE_OVERRIDES: dict[tuple[str, str, str], _ChunkwiseCfg] = {}
+
+
+_ARCH_OVERRIDES: dict = {}
+
+
+def _auto_config(dot_prec: int, cap: tuple, shape_hint: str | None = None) -> tuple:
+    """Look up chunkwise launch params. Resolution order: shape override →
+    per-(arch, prec) table → ("ampere", prec) fallback. (`_ARCH_OVERRIDES` is
+    applied by `_get_arch_config`, not here.)
+
+    Returns the legacy 8-tuple `(a_nw, a_BS, b_nw, b_ns, b_use_acc, c_nw, c_BS, c_ns)`.
+    """
+    arch = _arch_key(cap)
+    prec = _prec_key(dot_prec)
+
+    if shape_hint is not None:
+        cfg = _CHUNKWISE_SHAPE_OVERRIDES.get((arch, prec, shape_hint))
+        if cfg is not None:
+            return cfg.as_tuple()
+
+    cfg = _CHUNKWISE_TUNING.get((arch, prec)) or _CHUNKWISE_TUNING[("ampere", prec)]
+    return cfg.as_tuple()
+
+
+_ARCH_CONFIG_CACHE: dict = {}  # (dot_prec, shape_hint, dev_idx) -> 8-tuple
+
+
+def _get_arch_config(
+    dot_precision: int = 0,
+    shape_hint: str | None = None,
+    device: torch.device | int | None = None,
+):
+    """Returns (a_warps, a_BLOCK_S, b_warps, b_stages, b_use_acc_fusion,
+                c_warps, c_BLOCK_S, c_stages).
+
+    dot_precision: 0=bf16 TC, 1=TF32 TC, 2=IEEE fp32.
+    device: capability source; pass ``qkv.device`` in multi-GPU single-process
+            setups so the right tuning bucket is chosen (defaults to current device).
+    """
+    # Memoized: the resolved 8-tuple depends only on (dot_precision,
+    # shape_hint, device capability), and capability is fixed per device.
+    # Removes per-call is_available/get_device_capability/get_device_properties
+    # overhead (~10 us) on the hot path. Resolved values are unchanged, so
+    # launch configs (and outputs) stay byte-identical.
+    if device is None:
+        dev_idx = torch.cuda.current_device() if torch.cuda.is_available() else -1
+    elif isinstance(device, int):
+        dev_idx = device
+    else:
+        dev_idx = (
+            device.index
+            if device.index is not None
+            else (torch.cuda.current_device() if torch.cuda.is_available() else -1)
+        )
+    cache_key = (dot_precision, shape_hint, dev_idx)
+    hit = _ARCH_CONFIG_CACHE.get(cache_key)
+    if hit is not None:
+        return hit
+    if dev_idx < 0 or not torch.cuda.is_available():
+        cap = (9, 0)  # assume modern when querying from CPU
+    else:
+        cap = torch.cuda.get_device_capability(dev_idx)
+    key = (cap, dot_precision)
+    if key in _ARCH_OVERRIDES:
+        cfg = _ARCH_OVERRIDES[key]
+    else:
+        cfg = _auto_config(dot_precision, cap, shape_hint)
+    _ARCH_CONFIG_CACHE[cache_key] = cfg
+    return cfg
+
