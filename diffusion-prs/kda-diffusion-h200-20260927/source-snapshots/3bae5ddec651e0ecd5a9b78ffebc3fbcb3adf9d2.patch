+
+// Blocks-per-SM is a pure function of (kernel pointer, threads, device). A single
+// function-local `static` would conflate distinct launch configurations that share a
+// kernel pointer TYPE (CUDA function pointer types are shared across template
+// instantiations with identical signatures, and the SAME kernel is queried with
+// threads=256 OR threads=768 depending on the row size), freezing whichever value was
+// computed first. Memoize keyed on the actual (kernel, threads, device) triple so each
+// launch configuration gets its correct occupancy, stable across shape-order and
+// device-order, without re-querying on every call (the query is measurable on these
+// latency-bound rows). The tiny static table holds at most one entry per distinct
+// launch configuration this process dispatches.
+template <typename KernelT>
+int64_t cached_blocks_per_sm(KernelT kernel, int64_t threads, int device_id) {
+  struct Entry {
+    const void* kernel;
+    int32_t threads;
+    int32_t device;
+    int64_t blocks_per_sm;
+  };
+  static std::mutex mutex;
+  static std::vector<Entry> entries;
+  const void* key = reinterpret_cast<const void*>(kernel);
+  std::lock_guard<std::mutex> lock(mutex);
+  for (const Entry& entry : entries) {
+    if (entry.kernel == key && entry.threads == static_cast<int32_t>(threads) &&
+        entry.device == static_cast<int32_t>(device_id)) {
+      return entry.blocks_per_sm;
+    }
+  }
+  const int64_t blocks_per_sm = static_cast<int64_t>(host::runtime::get_blocks_per_sm(
+      kernel, static_cast<int32_t>(threads)));
+  entries.push_back(
+      {key, static_cast<int32_t>(threads), static_cast<int32_t>(device_id), blocks_per_sm});
+  return blocks_per_sm;
+}
