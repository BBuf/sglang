+// SM count is a per-device attribute; the runtime helper already caches it per
+// device (keyed by device_id), so call it directly. This avoids the original bug of
+// a single function-local static freezing the FIRST device's count for all devices.
+int64_t sm_count(int device_id) {
+  return static_cast<int64_t>(host::runtime::get_sm_count(device_id));
