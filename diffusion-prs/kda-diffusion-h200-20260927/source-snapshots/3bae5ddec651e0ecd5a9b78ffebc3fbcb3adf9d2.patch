+// libdivide-style u32 magic (round-up method). Validated exact for the divisors used.
+struct U32Magic {
+  uint32_t M;  // 0 => power-of-two divisor, use shift s
+  uint32_t s;
+};
+
+inline U32Magic compute_u32_magic(uint32_t d) {
+  U32Magic r;
+  if ((d & (d - 1)) == 0) {
+    r.M = 0;
+    r.s = 31 - __builtin_clz(d);
+    return r;
+  }
+  const uint32_t L = 32 - __builtin_clz(d - 1);  // floor(log2(d)) + 1
+  const uint64_t m = ((static_cast<uint64_t>(1) << (32 + L)) + d - 1) / d;  // 33-bit
+  r.M = static_cast<uint32_t>(m - (static_cast<uint64_t>(1) << 32));
+  r.s = L;
+  return r;
+}
+
+SGL_DEVICE uint32_t magic_div(uint32_t n, uint32_t M, uint32_t s) {
+  if (M == 0) return n >> s;
+  const uint32_t q = __umulhi(n, M);
+  const uint32_t t = ((n - q) >> 1) + q;
+  return t >> (s - 1);
+}
