+@triton.jit
+def _qknorm_complex_rope_rows_tiled(
+    x_ptr,
+    weight_ptr,
+    rope_ptr,
+    row,
+    ROWS,
+    SEQ: tl.constexpr,
+    HEADS: tl.constexpr,
+    LOG2H: tl.constexpr,
+    EPS: tl.constexpr,
+    FUSE_REAL_SIN: tl.constexpr,
+    POW2H: tl.constexpr,
+    SEQMULT: tl.constexpr,
+    RPB: tl.constexpr,
