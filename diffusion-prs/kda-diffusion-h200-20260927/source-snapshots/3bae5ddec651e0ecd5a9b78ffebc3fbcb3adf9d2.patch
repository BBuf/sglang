+    const int64_t ct = cache_t.unwrap();
+    const int64_t depth_left = pad_d_left - ct;
+    RuntimeCheck(depth_left >= 0, "pad_d_left must be >= cache_t");
+    RuntimeCheck(pad_d_right == 0, "pad_d_right must be 0");
+    RuntimeCheck(pad_w_left == pad_w_right, "width padding must be symmetric");
+    RuntimeCheck(pad_h_top == pad_h_bottom, "height padding must be symmetric");
+    RuntimeCheck(out_t.unwrap() == t_size.unwrap() + cache_t.unwrap() + depth_left + pad_d_right, "out_t mismatch");
+    RuntimeCheck(out_h.unwrap() == h_size.unwrap() + pad_h_top + pad_h_bottom, "out_h mismatch");
+    RuntimeCheck(out_w.unwrap() == w_size.unwrap() + pad_w_left + pad_w_right, "out_w mismatch");
+
+    const int64_t total = bsz.unwrap() * channels.unwrap() * out_t.unwrap() * out_h.unwrap() * out_w.unwrap();
+    if (total == 0) {
+      return;
+    }
+
+    constexpr int kVec = 16 / sizeof(T);
+    RuntimeCheck(total % kVec == 0, "output element count must be divisible by vector width");
+    RuntimeCheck(reinterpret_cast<uintptr_t>(out.data_ptr()) % 16 == 0, "output pointer must be 16-byte aligned");
+
+    const int64_t bc_total = bsz.unwrap() * channels.unwrap();
+    // Pick warps-per-row by row width (16B groups): small rows get more warps
+    // for bandwidth, large rows get one warp (more blocks / parallelism).
+    const int64_t wb16 = (w_size.unwrap() * static_cast<int64_t>(sizeof(T))) >> 4;
+    int wpr = 1;
+    // Wide rows (>= ~320 fp32 elements => wb16 >= 80) benefit from 2 warps/row;
+    // very small rows (wb16 < 8) also use 2 warps/row for bandwidth.
+    // ct=1 widest rows (single cache frame, w=640) benefit from 4 warps/row;
+    // ct=2 (two frames) prefers 2. Small rows use 2 for bandwidth.
+    if (wb16 < 8) wpr = 2;
+    else if (wb16 >= 160 && ct == 1) wpr = 4;
+    else if (wb16 >= 80) wpr = 2;
+    const int64_t rows_per_block = kWarps / wpr;
+    int64_t bz = (bc_total + rows_per_block - 1) / rows_per_block;
+    if (bz > 65535) bz = 65535;  // CUDA grid.z limit
+    const int64_t bc_per_bz = static_cast<int64_t>(bz) * rows_per_block;
+    // number of bc chunks folded into grid.y (1 in the common case)
+    int64_t by = (bc_total + bc_per_bz - 1) / bc_per_bz;
+    const int64_t max_gy = 65535 / (by > 0 ? by : 1);
+    uint32_t gy = static_cast<uint32_t>(out_t.unwrap());
+    if (gy > 132u) gy = 132u;
+    if (static_cast<int64_t>(gy) > max_gy) gy = static_cast<uint32_t>(max_gy);
+    dim3 grid(static_cast<uint32_t>(out_h.unwrap()),
+              static_cast<uint32_t>(gy * by), static_cast<uint32_t>(bz));
+    const bool big = by > 1;
+    const bool stride_od = static_cast<int64_t>(gy) < out_t.unwrap();
+    auto launch = [&](auto wpr_c) {
+      constexpr int WPR = decltype(wpr_c)::value;
+      if (big) {
+        LaunchKernel(grid, kT, device.unwrap()).enable_pdl(kUsePDL)(
+            fused_rows_kernel<T, WPR, true, true>,
+            static_cast<const T*>(x.data_ptr()),
+            static_cast<const T*>(cache.data_ptr()),
+            static_cast<T*>(out.data_ptr()),
+            channels.unwrap(), t_size.unwrap(), h_size.unwrap(), w_size.unwrap(),
+            ct, depth_left, pad_h_top, pad_w_left, out_w.unwrap(), bc_total,
+            out_t.unwrap(), static_cast<int64_t>(gy));
+      } else if (stride_od) {
+      LaunchKernel(grid, kT, device.unwrap()).enable_pdl(kUsePDL)(
+          fused_rows_kernel<T, WPR, false, true>,
+          static_cast<const T*>(x.data_ptr()),
+          static_cast<const T*>(cache.data_ptr()),
+          static_cast<T*>(out.data_ptr()),
+          channels.unwrap(), t_size.unwrap(), h_size.unwrap(), w_size.unwrap(),
+          ct, depth_left, pad_h_top, pad_w_left, out_w.unwrap(), bc_total,
+          out_t.unwrap(), static_cast<int64_t>(gy));
+      } else {
+      LaunchKernel(grid, kT, device.unwrap()).enable_pdl(kUsePDL)(
+          fused_rows_kernel<T, WPR, false, false>,
+          static_cast<const T*>(x.data_ptr()),
+          static_cast<const T*>(cache.data_ptr()),
+          static_cast<T*>(out.data_ptr()),
+          channels.unwrap(), t_size.unwrap(), h_size.unwrap(), w_size.unwrap(),
+          ct, depth_left, pad_h_top, pad_w_left, out_w.unwrap(), bc_total,
+          out_t.unwrap(), static_cast<int64_t>(gy));
+      }
+    };
+    if (wpr == 4) launch(std::integral_constant<int, 4>{});
+    else if (wpr == 2) launch(std::integral_constant<int, 2>{});
+    else launch(std::integral_constant<int, 1>{});
+  }
+};
